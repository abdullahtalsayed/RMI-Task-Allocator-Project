rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profileId() {
      return signedIn()
        && exists(/databases/$(database)/documents/usersByAuth/$(request.auth.uid))
        ? get(/databases/$(database)/documents/usersByAuth/$(request.auth.uid)).data.profileId
        : null;
    }

    function profile() {
      return profileId() != null
        ? get(/databases/$(database)/documents/users/$(profileId()))
        : null;
    }

    function isManager() {
      return profile() != null && profile().data.role == 'manager';
    }

    function isSupervisor() {
      return profile() != null && profile().data.role == 'supervisor';
    }

    function isManagerOrSupervisor() {
      return profile() != null
        && profile().data.role in ['manager', 'supervisor', 'managing_director', 'executive_director'];
    }

    function isTeamLeader() {
      return profile() != null && profile().data.role == 'team_leader';
    }

    function canViewAllJobs() {
      return profile() != null
        && (profile().data.viewAll == 'yes'
            || profile().data.role in ['manager', 'supervisor', 'managing_director', 'executive_director']);
    }

    function managerDocExists() {
      return exists(/databases/$(database)/documents/users/manager);
    }

    match /usersByAuth/{authUid} {
      allow read: if signedIn() && request.auth.uid == authUid;
      allow create: if signedIn() && request.auth.uid == authUid
        && request.resource.data.profileId is string;
      allow update: if signedIn() && request.auth.uid == authUid;
      allow delete: if false;
    }

    match /users/{userId} {
      // Unauthenticated needsActivation bypass removed (C-2).
      // Activation flow creates Firebase Auth first, reads profile while signed in.
      allow read: if signedIn();
      allow create: if (signedIn() && isManager())
        || (userId == 'manager' && !managerDocExists());
      allow update: if signedIn() && (isManager() || profileId() == userId);
      allow delete: if signedIn() && isManager();
    }

    match /jobs/{jobId} {
      allow read: if signedIn() && (
        canViewAllJobs()
        || resource.data.owner == profileId()
        || resource.data.wfCreatedBy == profileId()
        || resource.data.teamLeaderId == profileId()
        || resource.data.drafterId == profileId()
      );

      // H-4: restrict job creation to roles that legitimately create jobs
      allow create: if signedIn() && (
        isManagerOrSupervisor()
        || isTeamLeader()
        || profile().data.role == 'sales_operation'
        || profile().data.role == 'employee'
        || profile().data.role == 'drafter'
      );

      // H-5: TL update restricted to workflow-relevant fields only
      allow update: if signedIn() && (
        isManager()
        || (isSupervisor() && resource.data.owner == profileId())
        || resource.data.owner == profileId()
        || (
          resource.data.teamLeaderId == profileId()
          && isTeamLeader()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'stage', 'wfHistory', 'owner', 'drafterId', 'teamLeaderId',
            'status', 'started', 'completed', 'durationTotalMs',
            'releaseEligible', 'rejectedSample', 'rejectNote',
            'checklist', 'type', 'priority', 'notes', 'deadline',
            'totalPausedMs', 'pausedAt', 'managerNote'
          ])
        )
      );

      allow delete: if signedIn() && (
        isManager()
        || resource.data.owner == profileId()
        || (isTeamLeader() && resource.data.teamLeaderId == profileId())
      );
    }

    match /jobsArchive/{jobId} {
      allow read, write: if signedIn() && isManager();
    }

    // H-6: any signed-in user may push a notification to any target userId.
    // Read/update/delete restricted to the notification's target user only.
    // Cross-user create is required for drafter→TL and salesOp→TL basket events.
    match /notifications/{id} {
      allow read: if signedIn() && resource.data.userId == profileId();
      allow create: if signedIn();
      allow update, delete: if signedIn()
        && resource.data.userId == profileId();
    }

    match /extensions/{id} {
      allow read: if signedIn();
      // H-4 variant: only job owners or leads can file extensions
      allow create: if signedIn() && (
        isManagerOrSupervisor()
        || isTeamLeader()
        || profile().data.role in ['employee', 'drafter', 'sales_operation']
      );
      allow update, delete: if signedIn() && isManagerOrSupervisor();
    }

    match /broadcasts/{id} {
      allow read: if signedIn();
      allow create, delete: if signedIn() && isManager();
      allow update: if signedIn() && isManager();
    }

    // H-7: events (job history/comments) must belong to a job the user can access
    match /events/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && (
        isManagerOrSupervisor()
        || isTeamLeader()
        || profile().data.role in ['employee', 'drafter', 'sales_operation']
      );
      allow update, delete: if signedIn() && isManagerOrSupervisor();
    }

    match /loginlogs/{id} {
      allow read: if signedIn() && isManagerOrSupervisor();
      allow create: if signedIn();
      allow update, delete: if signedIn() && isManager();
    }

    match /config/{id} {
      allow read: if signedIn();
      allow write: if signedIn() && isManager();
    }

  }
}

